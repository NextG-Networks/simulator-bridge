      "id": 1,
      "title": "gNB KPIs",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "targets": [
        {
          "query": "from(bucket: \"ns3-kpis\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"gnb_kpis\")",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
